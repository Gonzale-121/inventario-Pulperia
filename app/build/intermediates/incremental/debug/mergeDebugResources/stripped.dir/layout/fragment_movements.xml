<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/etBarcodeSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escribir código de barras para seleccionar"
        android:inputType="number" />

    <Spinner
        android:id="@+id/spProduct"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <RadioGroup
        android:id="@+id/rgType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton android:id="@+id/rbIn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:checked="true" android:text="Entrada" />
        <RadioButton android:id="@+id/rbOut" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Salida" />
    </RadioGroup>

    <EditText
        android:id="@+id/etQty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cantidad"
        android:inputType="number" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar movimiento" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Historial"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMovements"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
